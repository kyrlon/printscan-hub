# Copy to .env and edit.  (cp .env.example .env)

# Login for the portal's Admin page AND the CUPS web admin (http://<server>:<CUPS_PORT>/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Shown in the portal header
HUB_NAME=PrintScan Hub

TZ=America/New_York

# Port of the upload & print portal (must be free on the host)
PORTAL_PORT=80
# Port laptops/phones print to (IPP) and the CUPS web admin. 631 is the standard
# and what clients try first; change it only if 631 is taken on this host (e.g. by
# the host's own CUPS you want to keep). AirPrint/Mopria discovery follows it;
# printers added by hand need the new port in their address.
CUPS_PORT=631
# Internal port of the scan app (people use it through the portal at /scan)
SCAN_PORT=8080
# Largest file people can upload to print (MB). Shown next to the file picker.
MAX_UPLOAD_MB=200
# --- Who sees scans (Scan page -> Files). Shared by default; a browser can switch
# to "Only this browser", and people with an account see their own files anywhere.
# Limits: max files (oldest removed beyond it) and days kept; 0 = unlimited.
PRIVATE_MAX_FILES=20
PRIVATE_KEEP_DAYS=7
ACCOUNT_MAX_FILES=200
ACCOUNT_KEEP_DAYS=0
# Let people create their own accounts (otherwise the admin creates them)
ALLOW_SIGNUP=false

# Default scan area: letter (8.5x11 in) | legal | a4 | a5 | full (whole glass)
SCAN_DEFAULT_PAPER=letter
# Where scans start from: auto (feeder if it has paper, else the glass) |
# auto-duplex | flatbed | adf | duplex | remember (last used, scanservjs default)
SCAN_DEFAULT_SOURCE=auto
# Largest total driver upload on the admin page (MB); vendor packages can be big.
MAX_DRIVER_UPLOAD_MB=500

# LAN IP address of this hub, e.g. 192.168.1.20. Used in the setup instructions
# shown on the admin page and for FTP passive mode (required on Docker Desktop).
HUB_ADDRESS=

# --- Scan inbox: lets a printer's own "Scan to FTP / Scan to Network" button
# save straight into ./scans (shown on the scan page). The printer logs in with:
SCAN_INBOX_USER=scanner
SCAN_INBOX_PASSWORD=change-me-too
# SCAN_INBOX_FTP_PORT=21
# SCAN_INBOX_SMB=true         # also share \\<hub>\scans over SMB (Linux hosts only)
# SCAN_INBOX_SMB_PORT=445
# SCAN_INBOX_SMB1=false       # only for very old printers that need SMB1
# SCAN_INBOX_UID=1000         # owner of files written to ./scans

# Printer auto-discovery (Bonjour/AirPrint/Mopria): auto | host | internal | off
AVAHI=auto

# Build-time: include LibreOffice so Word/Excel/PowerPoint files can be printed
# from the portal. Set to false for a much smaller image (rebuild afterwards).
INSTALL_OFFICE=true

# Scanners that are not auto-detected (separate multiple with ;)
# SANED_NET_HOSTS=192.168.1.50
# AIRSCAN_DEVICES=MyScanner=http://192.168.1.50/eSCL,eSCL
# PIXMA_HOSTS=192.168.1.51
